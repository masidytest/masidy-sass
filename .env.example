# Control plane database: YOUR Supabase project (Auth + the tables in supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only

# Reseller org: a DEDICATED Supabase account/org that only holds customer projects.
# A personal access token carries the same privileges as its account.
SUPABASE_MGMT_TOKEN=                  # server only
SUPABASE_ORG_ID=

# Vercel: token scoped to the one project/team this app runs in. Never use a full-account token here.
VERCEL_TOKEN=                         # server only
VERCEL_TEAM_ID=
VERCEL_GATEWAY_PROJECT_ID=            # the Vercel project that serves *.masidy.app

# Vercel Blob read-write token is injected by the Blob store. Server only.
BLOB_READ_WRITE_TOKEN=

RESEND_API_KEY=                       # server only
GATEWAY_BASE_DOMAIN=masidy.app
